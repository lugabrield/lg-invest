# =====================================================================
# LG INVEST - Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha conforme necessário.
# NUNCA versione o arquivo .env real. Nenhuma chave de API no código.
# =====================================================================

# Ambiente: development | production
ENVIRONMENT=development

# Banco de dados (MVP usa SQLite local). `session.py` já lê esta variável
# via `settings.database_url` e já trata SQLite x Postgres condicionalmente
# — trocar para Postgres/Supabase no futuro não exige mudar código, só o
# valor abaixo (ver docs/SUPABASE_MIGRATION_PLAN.md).
DATABASE_URL=sqlite:///./data/lg_invest.db

# Exemplo de DATABASE_URL para quando migrar para Supabase/PostgreSQL
# (placeholders — NUNCA coloque a URL real aqui nem em nenhum arquivo
# versionado; configure via variável de ambiente / secrets do Streamlit
# Community Cloud):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE

# Provedores de dados de mercado
YAHOO_FINANCE_ENABLED=true
# Câmbio USD/BRL automático (Sprint 12): BCB PTAX é gratuito e sem chave.
# Desligar aqui pula direto para o fallback Yahoo Finance / manual.
BCB_FX_ENABLED=true
# FMP_API_KEY=your_key_here
# FINNHUB_API_KEY=your_key_here

# IA (fora do MVP)
# OPENAI_API_KEY=optional

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Sincronização com o Dividendos.me (Sprint 23). Credenciais da SUA conta
# em https://app.dividendos.me/ — usadas só para login via Playwright,
# nunca salvas em banco, nunca logadas, nunca exibidas na UI (a tela só
# mostra "configurado: sim/não"). No Streamlit Community Cloud, configure
# o equivalente em st.secrets:
#   [dividendos_me]
#   email = "..."
#   password = "..."
# DIVIDENDOS_ME_EMAIL=
# DIVIDENDOS_ME_PASSWORD=
